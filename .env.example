# Private key for deployment (without 0x prefix)
# NEVER commit this to version control
PRIVATE_KEY=your_private_key_here

# Core Testnet 2 RPC URL
CORE_TESTNET2_RPC=https://rpc.test2.btcs.network

# Optional: Core Explorer API key for contract verification
CORE_EXPLORER_API_KEY=your_api_key_here

# Optional: Enable gas reporting
REPORT_GAS=true

# Optional: CoinMarketCap API key for gas reporting
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Network configuration
NETWORK=coreTestnet2
CHAIN_ID=1115PRIVATE_KEY=
